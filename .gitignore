.build
.DS_Store
Package.resolved

# Tuist generated (regenerate with: tuist generate)
*.xcodeproj
*.xcworkspace
Derived/

# Xcode user data
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Build artifacts
build/
dist/
.serena/
DerivedData/
*.dSYM.zip
*.dSYM

# Personal Claude Code settings (per-project, never commit)
.claude/settings.local.json

# --- Secrets & personal runtime data (NEVER commit) ---
.env
.env.*
!.env.example
*.pem
*.p12
*.mobileprovision
*.cer
*.certSigningRequest
/secrets/
/credentials/
auth.json
**/auth.json

# If someone copies local app config into the tree
.smartquota/
.claudebar/
# accidental dump of live settings at repo root only
/settings.json

# Releases: keep folder + notes in git; large binaries stay local
releases/**/*.zip
releases/**/*.dmg
releases/**/*.pkg
releases/**/*.app/
releases/**/智额.app/
releases/**/*.xcarchive/

# Local notarization / signing leftovers
*.notarize.log
notary-log*.json

# Local history dump (not part of the public product tree)
/archive-root/
